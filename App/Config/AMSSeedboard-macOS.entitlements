<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- 0.5: printing a board. -->
	<key>com.apple.security.print</key>
	<true/>
	<!-- 0.9: milestones into the calendar. -->
	<key>com.apple.security.personal-information.calendars</key>
	<true/>
	<!-- 0.9: the title of a web page in a thing's words is fetched. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- PARAGON's shared folder, in the Mac's spelling (Team ID in front): Inbox lines wait there. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>D24ENP83QQ.group.com.schabbauer.amspara</string>
	</array>
	<!-- Seedboard's own iCloud folder first; PARAGON's second, so a board can be handed over. -->
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.schabbauer.AMSSeedboard</string>
		<string>iCloud.com.schabbauer.AMSPara</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudDocuments</string>
	</array>
	<key>com.apple.developer.ubiquity-container-identifiers</key>
	<array>
		<string>iCloud.com.schabbauer.AMSSeedboard</string>
		<string>iCloud.com.schabbauer.AMSPara</string>
	</array>
</dict>
</plist>
